SUNO_API_KEY=
MAX_BOT_TOKEN=
# Обязательно сменить в prod (длинная случайная строка)
JWT_SECRET=change-me-to-long-random-string
SILICONFLOW_API_KEY=
ELEVENLABS_API_KEY=
WEB_HOST=0.0.0.0
WEB_PORT=8010
DB_PATH=./data/music_bot.db
# sqlite (default) | postgres (+ DATABASE_URL или PG*)
DB_DRIVER=sqlite
# Amvera / Postgres:
# DATABASE_URL=postgres://USER:PASS@amvera-LOGIN-cnpg-PROJECT-rw:5432/DBNAME?sslmode=disable
# Либо вместо URL:
# PGHOST=amvera-LOGIN-cnpg-PROJECT-rw
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# PGSSLMODE=disable
MEDIA_ROOT=./data/media
# Amvera: MEDIA_ROOT=/data/media , PORT=80 (см. deploy/AMVERA.md)
# LOG_PATH=   # пусто = только stdout (удобно для Amvera)
BOT_MODE=polling
MAX_API_BASE=https://platform-api2.max.ru
ACEDATA_SUNO_URL=https://api.acedata.cloud/suno/audios
ACEDATA_SUNO_TASKS_URL=https://api.acedata.cloud/suno/tasks
SUNO_MODEL=chirp-v5-5
ACEDATA_ASYNC=true
ACEDATA_POLL_INTERVAL=3
ACEDATA_MAX_WAIT=300
# Второй провайдер генерации — ACE-Step cloud (https://acemusic.ai/playground/api-key)
ACEMUSIC_API_KEY=
ACEMUSIC_BASE_URL=https://api.acemusic.ai
ACEMUSIC_MODEL=acemusic/acestep-v1.5-turbo
ACEMUSIC_TIMEOUT=600
# auto = AceData → при ошибке баланса/auth AceMusic | acedata | acemusic
MUSIC_PROVIDER=auto
GEN_RATE_LIMIT_HOUR=10
GEN_RATE_LIMIT_DAY=40
# Тесты: true = не списывать кредиты, без rate-limit и квоты клонов (не для прод-оплаты)
CREDITS_UNLIMITED=false
VOICE_CLONE_PROVIDER=acedata,elevenlabs,siliconflow
VOICE_CLONE_LIMIT_DAY=3
# Публичный URL приложения — обязателен для AceData clone/cover (AceData скачивает /uploads/…)
WEB_PUBLIC_URL=https://your-domain.com
ACEDATA_SUNO_VOICES_URL=https://api.acedata.cloud/suno/voices
ACEDATA_SUNO_UPLOAD_URL=https://api.acedata.cloud/suno/upload
# Опционально: точный lip-sync поющего портрета (иначе Kling-клип через AceData)
HEDRA_API_KEY=

# Видео / фото FX
# Google Veo (опционально; без ключа — Kling через SUNO_API_KEY)
# VEO_API_KEY=
# GEMINI_API_KEY=
# VEO_MODEL=veo-2.0-generate-001
# Апскейл фото (предпочтительно Replicate; иначе AceData fal при SUNO_API_KEY)
# REPLICATE_API_TOKEN=

# Дистрибуция Spotify/Яндекс/Apple/VK — партнёрский webhook (иначе релизы остаются в очереди)
# DISTRIBUTION_WEBHOOK_URL=https://partner.example/uvo/releases
# DISTRIBUTION_WEBHOOK_SECRET=

# Prod: оба false. Локальный demo: ALLOW_ANON=true (все запросы как demo_user)
DEV_AUTH=false
ALLOW_ANON=false
# Бесплатный topup только для локалки
DEMO_TOPUP=false

# Обязателен для POST /api/max/webhook (header X-Max-Bot-Api-Secret)
MAX_WEBHOOK_SECRET=

# ЮKassa (опционально): POST /api/credits/checkout + webhook /api/payments/yookassa
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27  # optional IP allowlist

# Ops: /metrics and /health full dump
# METRICS_TOKEN=

# Dual AceData clips (default off — see COST.md)
# DUAL_OUTPUT=false

# Lyrics assist (OpenAI-compatible)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

DOWNLOAD_ALLOW_HOSTS=

# BOT_MODE=polling|webhook
# For prod webhook set BOT_MODE=webhook and run deploy/webhook_setup.go
WEB_PUBLIC_URL=https://your-domain.com
